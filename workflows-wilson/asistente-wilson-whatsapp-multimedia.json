      "id": "fa000000-0016-4d16-9316-dd0000000016",
      "name": "Guardar pendiente",
      "type": "n8n-nodes-base.dataTableTool",
      "typeVersion": 1.1,
      "position": [1540, 260]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": { "__rl": true, "mode": "name", "value": "pendientes" },
        "matchType": "allConditions",
        "filters": { "conditions": [ { "keyName": "estado", "condition": "eq", "keyValue": "pendiente" } ] },
        "returnAll": true
      },
      "id": "fa000000-0017-4d17-9317-dd0000000017",
      "name": "Buscar pendientes",
      "type": "n8n-nodes-base.dataTableTool",
      "typeVersion": 1.1,
      "position": [1680, 260]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": { "__rl": true, "mode": "name", "value": "pendientes" },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            { "keyName": "id", "condition": "eq", "keyValue": "={{ $fromAI('id', 'El id numérico de la fila del pendiente que se completó (obtenido con Buscar pendientes)', 'number') }}" }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
