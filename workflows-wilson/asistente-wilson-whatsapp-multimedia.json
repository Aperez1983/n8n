            "tarea": "={{ $fromAI('tarea', 'SOLO la descripción de la tarea, sin día ni fecha', 'string') }}",
            "fecha": "={{ $fromAI('fecha', 'Fecha de la tarea en formato AAAA-MM-DD; vacío si no aplica', 'string') }}",
            "estado": "pendiente",
            "categoria": "={{ $fromAI('categoria', 'Una de: Hogar, Trabajo, Colegio, Otros', 'string') }}",
            "persona": "={{ $fromAI('persona', 'Nombre de quien pidió la tarea (Wilson, Maite, Isidora, etc.)', 'string') }}"
          },
          "matchingColumns": [], "schema": []
        },
        "options": {}
