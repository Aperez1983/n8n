          "matchingColumns": [], "schema": []
        },
        "options": {}
      },
      "id": "fa000000-0018-4d18-9318-dd0000000018",
      "name": "Completar pendiente",
      "type": "n8n-nodes-base.dataTableTool",
      "typeVersion": 1.1,
